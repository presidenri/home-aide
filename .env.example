# Environment variables for Home Aide
# Copy this to .env and customize as needed

# Timezone for proper timestamps
TZ=America/New_York

# go2rtc restream credentials (port 8554); required for clients other than
# Frigate itself, including Home Assistant (Frigate integration > RTSP URL template)
FRIGATE_RTSP_USER=frigate-rtsp
FRIGATE_RTSP_PASSWORD=your-secure-password-here

# MQTT users, stored in configs/mosquitto/passwd (see README "MQTT Configuration")
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=your-frigate-mqtt-password
# Not read by docker compose - enter these in Home Assistant's MQTT integration
HA_MQTT_USER=homeassistant
HA_MQTT_PASSWORD=your-ha-mqtt-password

# Camera credentials (FRIGATE_ prefix required for use in config)
# Each camera gets its own prefix; add the same variables to the frigate
# service's environment list in docker-compose.yml when adding a camera.

# Hikvision DS-2CD2387G3-LI2UY (home_garage_main)
FRIGATE_HIKVISION1_CAMUSER=admin
FRIGATE_HIKVISION1_CAMPASS=your-camera-password
FRIGATE_HIKVISION1_CAMIP=192.168.1.100

# TP-Link Tapo C319 (c319_garage_main)
# Use the camera account created in the Tapo app (Camera Settings > Advanced > Camera Account),
# not your TP-Link cloud login.
FRIGATE_TAPO1_CAMUSER=your-tapo-camera-account
FRIGATE_TAPO1_CAMPASS=your-tapo-camera-password
FRIGATE_TAPO1_CAMIP=192.168.1.101

# Cloudflare Tunnel configuration
# Get your tunnel token from https://one.dash.cloudflare.com/
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
